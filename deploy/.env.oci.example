# Copy this file to /opt/agent-series/.env on the OCI VM. Do not commit that copy.
POSTGRES_DB=agent_series
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Jenkins updates IMAGE_TAG on every verified main deployment.
API_IMAGE=dockerhub-user/agent-series-api
WORKER_IMAGE=dockerhub-user/agent-series-worker
IMAGE_TAG=sha-replace-on-first-deploy

# DuckDNS hostname pointing to this VM and an email for Caddy certificate notices.
BACKEND_DOMAIN=api-agent-series-your-handle.duckdns.org
CADDY_EMAIL=you@example.com

# The Vercel production URL. OAuth callbacks must also use this origin because
# Vercel proxies /api/* and therefore owns the browser session cookie.
APP_WEB_URL=https://your-project.vercel.app
GOOGLE_OAUTH_REDIRECT_URI=https://your-project.vercel.app/api/connectors/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback

# Copy the remaining application secrets from .env.example below this line.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-2.5-pro
EMBEDDING_MODEL=intfloat/multilingual-e5-small
HF_TOKEN=
TAVILY_API_KEY=
CONNECTOR_ENCRYPTION_KEY=
USER_CREDENTIAL_ENCRYPTION_KEY=
SYSTEM_ADMIN_EMAIL=your-admin@example.com
