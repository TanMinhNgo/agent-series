FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser
COPY requirements-ci.lock ./
RUN python -m pip install --upgrade pip && python -m pip install --require-hashes --requirement requirements-ci.lock

COPY alembic.ini ./
COPY api ./api
COPY agent_core ./agent_core
COPY migrations ./migrations

RUN mkdir -p /app/uploads /app/knowledge && chown -R appuser:appuser /app
USER appuser

FROM base AS api
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS worker
CMD ["python", "-m", "agent_core.worker"]
