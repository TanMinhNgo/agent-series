# ============================================================================
#  MẪU CẤU HÌNH CHO AI AGENT — sao chép file này thành .env rồi điền giá trị thật
#    Windows (PowerShell):  Copy-Item .env.example .env
#    macOS/Linux:           cp .env.example .env
#  LƯU Ý: KHÔNG commit file .env thật lên git (đã bị .gitignore chặn).
# ============================================================================

# ----------------------------------------------------------------------------
# 1) CHỌN NHÀ CUNG CẤP LLM ("bộ não" của agent)
#    Điền một trong: gemini | anthropic | openai | ollama
#    Bạn CHỈ cần điền key của provider mình chọn; các provider khác để trống cũng được.
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# ----------------------------------------------------------------------------
# 2) GEMINI (Google) — MẶC ĐỊNH của series này
#    Lấy key MIỄN PHÍ tại: https://aistudio.google.com/apikey
#    Gợi ý: dùng đúng key bạn đã tạo ở project RAG (bài trước) cho tiện.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Các model được phép hiện trên UI, cách nhau bằng dấu phẩy.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview,gemini-2.5-pro

# ----------------------------------------------------------------------------
# 3) ANTHROPIC (Claude) — tuỳ chọn, nếu bạn có key Claude
#    Lấy key tại: https://console.anthropic.com/
#    Model mặc định là loại mạnh nhất (đắt hơn). Muốn RẺ hơn, đổi thành:
#      ANTHROPIC_MODEL=claude-haiku-4-5
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Lấy model ID thật bằng Models API của Anthropic Console trước khi bật trên UI.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MODELS=claude-opus-4-1-20250805,claude-sonnet-4-20250514,claude-haiku-3-5-20241022

# ----------------------------------------------------------------------------
# 4) OPENAI (GPT / "Codex") — tuỳ chọn, nếu bạn có key OpenAI
#    Lấy key tại: https://platform.openai.com/api-keys
#    Đổi OPENAI_MODEL cho khớp model bạn được cấp (vd: gpt-4o, gpt-4o-mini...).
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-4o-mini

# ----------------------------------------------------------------------------
# 5) OLLAMA LOCAL — tuỳ chọn, chạy trên cùng máy với FastAPI.
#    Model được tự phát hiện qua Ollama; không cần API key hay allowlist trong .env.
# ----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Chỉ cần khi đặt LLM_PROVIDER=ollama; để trống thì UI chọn model local đầu tiên.
OLLAMA_MODEL=

# ----------------------------------------------------------------------------
# 6) THAM SỐ HÀNH VI CỦA AGENT (tinh chỉnh nếu muốn)
# ----------------------------------------------------------------------------
# Độ "ngẫu nhiên" của model. Với agent nên để THẤP để quyết định gọi tool ổn định.
# (Lưu ý: model Claude đời mới bỏ qua tham số này — điều đó là bình thường.)
AGENT_TEMPERATURE=0.2
# Số vòng "suy nghĩ -> gọi tool -> quan sát" tối đa cho mỗi câu hỏi (phanh an toàn).
AGENT_MAX_STEPS=5
# Giới hạn độ dài câu trả lời model sinh ra mỗi lượt.
AGENT_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# 6) DATA + RAG LOCAL
# ----------------------------------------------------------------------------
# Docker Compose cung cấp PostgreSQL + pgvector tại URL mặc định này.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent_series
# Model embedding đa ngôn ngữ, chạy local. Lần đầu sẽ tải model từ Hugging Face.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Token Hugging Face (read permission) để tải embedding model có xác thực,
# tránh warning/rate limit khi khởi động. Tạo tại https://huggingface.co/settings/tokens
HF_TOKEN=
# Tavily dùng để tìm nguồn web thật khi Thư viện không đủ thông tin. Để trống để tắt web search.
TAVILY_API_KEY=
KNOWLEDGE_DIR=knowledge
# Ảnh chat được lưu local trong thư mục này (không commit dữ liệu người dùng).
MEDIA_DIR=uploads

# ----------------------------------------------------------------------------
# 7) GOOGLE WORKSPACE CONNECTOR (P2.1, chỉ đọc Drive metadata + Calendar)
#    Tạo OAuth Web application trong Google Cloud Console, rồi thêm callback URL
#    bên dưới vào Authorized redirect URIs. Không đưa các giá trị thật vào Git.
#    Tạo CONNECTOR_ENCRYPTION_KEY bằng:
#    .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
CONNECTOR_ENCRYPTION_KEY=
# Key riêng để mã hóa API key cloud do từng user thêm trong Settings.
# Tạo bằng: .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_CREDENTIAL_ENCRYPTION_KEY=
# URL frontend để quay lại trang Plugin sau OAuth.
APP_WEB_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# 8) APP AUTH (Google Sign-In)
# ----------------------------------------------------------------------------
# Có thể dùng cùng OAuth client với Google Workspace ở trên: để trống 2 biến
# đầu thì backend tự dùng GOOGLE_OAUTH_CLIENT_ID/SECRET. Trong Google Cloud,
# thêm cả callback này vào Authorized redirect URIs.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
AUTH_SESSION_DAYS=14
SYSTEM_ADMIN_EMAIL=your-admin@example.com
# SMTP không phục vụ đăng nhập; dùng để gửi email thông báo khi lịch trình chạy xong.
# Cần cả SMTP_HOST và SMTP_FROM thì tính năng mới bật. Email chỉ kèm liên kết mở chat
# khi APP_WEB_URL trỏ tới địa chỉ công khai (không phải localhost).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
